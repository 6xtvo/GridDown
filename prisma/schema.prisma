// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum PostType {
  NEED
  OFFER
}

enum Urgency {
  URGENT    // Red — life threatening, time critical
  MODERATE  // Amber — important but not immediately dangerous
  LOW       // Green — general offers, non-urgent needs
}

enum Category {
  MEDICAL
  FOOD
  WATER
  SHELTER
  RESCUE
  EQUIPMENT
  SKILLS
  TRANSPORT
  COMMUNICATION
  OTHER
}

enum Status {
  AVAILABLE       // Ready to help or be helped
  HELPING         // Currently assisting someone
  NEED_HELP       // Currently in need
  UNAVAILABLE     // Not available right now
}

enum Skill {
  MEDICAL
  ENGINEERING
  FARMING
  CONSTRUCTION
  NAVIGATION
  COMMUNICATION
  TEACHING
  SECURITY
  COOKING
  MECHANICS
}

enum Resource {
  VEHICLE
  GENERATOR
  WATER
  FOOD
  MEDICAL_SUPPLIES
  TOOLS
  SHELTER
  FUEL
  RADIO
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          Role       @default(USER)
  status        Status     @default(AVAILABLE)
  bio           String?
  location      String?    // General area e.g. "Sector 4", "Downtown"
  skills        Skill[]
  resources     Resource[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  posts             Post[]
  responses         Response[]
  connectionsFrom   Connection[] @relation("ConnectionFrom")
  connectionsTo     Connection[] @relation("ConnectionTo")
  flagsSubmitted    Flag[]       @relation("FlagSubmitter")
}

// ─── Posts ───────────────────────────────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  type      PostType
  urgency   Urgency
  category  Category
  title     String
  body      String
  resolved  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Location
  location  String?  // General area e.g. "Sector 4"

  // Relations
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  responses Response[]
  flags     Flag[]

  @@index([authorId])
  @@index([resolved])
  @@index([urgency])
  @@index([category])
  @@index([expiresAt])
}

// ─── Responses ───────────────────────────────────────────────────────────────

model Response {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

// ─── Connections ─────────────────────────────────────────────────────────────

model Connection {
  id          String   @id @default(cuid())
  attestation String?  // e.g. "Sarah provided medical assistance during the crisis"
  createdAt   DateTime @default(now())

  // Relations
  fromId String
  from   User   @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     User   @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)

  // Prevent duplicate connections between the same two users
  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

// ─── Flags ───────────────────────────────────────────────────────────────────

model Flag {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())

  // Relations
  postId      String
  post        Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  submitterId String
  submitter   User   @relation("FlagSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)

  @@unique([postId, submitterId])
  @@index([postId])
}